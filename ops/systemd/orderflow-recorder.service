[Unit]
Description=orderflow recorder (read-only)

[Service]
Type=simple
WorkingDirectory=@ROOT@
ExecStart="@ROOT@/.venv/bin/python" -m orderflow.ops.cli record --scheduled --config "%h/.config/orderflow/config.yaml"
TimeoutStartSec=45min
TimeoutStopSec=45s
UMask=0077
Restart=on-failure
RestartSec=30s
